{
  "servers": {
    "google-maps-mcp-stdio": {
      "type": "stdio",
      "command": "java",
      "args": [
        "-Dspring.ai.mcp.server.stdio=true",
        "-Dspring.main.web-application-type=none",
        "-Dspring.main.banner-mode=off",
        "-jar",
        "${workspaceFolder}/target/google-maps-mcp-server.jar"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "MAP_PROVIDER": "openstreetmap",
        "GOOGLE_MAPS_API_KEY": ""
      }
    },
    "google-maps-mcp-streamable-http": {
      "type": "http",
      "url": "http://localhost:8080/mcp"
    }
  }
}
