# ============================================================================
# Google Maps-Like MCP Server (Java 21 + Spring Boot 3.x)
# Environment Configuration Template
# Copy this file to .env and populate API keys as needed.
# ============================================================================

# Server HTTP Port (used when MCP_TRANSPORT=http)
SERVER_PORT=8080

# MCP Transport Mode:
#   stdio -> Launches as a subprocess communicating via stdin/stdout JSON-RPC (logs go to stderr)
#   http  -> Launches embedded Tomcat with Streamable HTTP (/mcp) and Actuator (/actuator/health)
MCP_TRANSPORT=stdio

# Streamable HTTP Protocol mode (STREAMABLE, STATELESS, or SSE)
MCP_HTTP_PROTOCOL=STREAMABLE

# Primary Map Data Provider:
#   openstreetmap -> Free, zero-key default (Nominatim + Overpass + OSRM + Open-Meteo)
#   google        -> Google Maps Platform (Places, Geocoding, Directions, Distance Matrix, Elevation, TimeZone, Traffic)
#   mapbox        -> Mapbox Platform (Geocoding, Directions, Tiles)
#   graphhopper   -> GraphHopper Routing Engine
#   openrouteservice -> OpenRouteService Routing Engine
MAP_PROVIDER=openstreetmap

# Automatically fall back to OpenStreetMap/Nominatim/OSRM if the primary provider is unconfigured
MAP_FALLBACK_ENABLED=true

# External Provider API Keys (Never hardcode secrets in source code)
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
OPENROUTESERVICE_API_KEY=
GRAPHHOPPER_API_KEY=

# OpenStreetMap Ecosystem Base URLs (customizable for self-hosted instances)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_ELEVATION_BASE_URL=https://api.open-meteo.com
OSM_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# HTTP Client Timeouts (milliseconds)
HTTP_CONNECT_TIMEOUT_MS=5000
HTTP_READ_TIMEOUT_MS=15000

# Caching Configuration (Caffeine)
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=2000

# Logging Level (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
